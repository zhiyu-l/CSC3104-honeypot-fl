FROM flwr/superlink:1.40.0

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv

USER root
WORKDIR /app

COPY quickstart-numpy/pyproject.toml .
COPY quickstart-numpy/LICENSE ./LICENSE
COPY quickstart-numpy/quickstart_numpy ./quickstart_numpy

RUN sed -i '/flwr\[simulation\]/d' pyproject.toml \
    && uv pip install --python /python/venv/bin/python .

ENTRYPOINT ["flower-superlink"]