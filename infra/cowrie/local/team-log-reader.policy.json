{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Sid": "ListProjectBuckets",
      "Resource": [
        "arn:aws:s3:::csc3104-cowrie-orga",
        "arn:aws:s3:::csc3104-cowrie-orgb",
        "arn:aws:s3:::csc3104-cowrie-orgc"
      ],
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ]
    },
    {
      "Effect": "Allow",
      "Sid": "ReadProjectLogs",
      "Resource": [
        "arn:aws:s3:::csc3104-cowrie-orga/orga/raw/*",
        "arn:aws:s3:::csc3104-cowrie-orgb/orgb/raw/*",
        "arn:aws:s3:::csc3104-cowrie-orgc/orgc/raw/*"
      ],
      "Action": [
        "s3:GetObject"
      ]
    },
    {
      "Sid": "ReadProjectFeatures",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::csc3104-cowrie-orga/orga/processed/replay/*",
        "arn:aws:s3:::csc3104-cowrie-orgb/orgb/processed/replay/*",
        "arn:aws:s3:::csc3104-cowrie-orgc/orgc/processed/replay/*"
      ]
    },
    {
      "Sid": "ReadNightlySessions",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::csc3104-cowrie-orga/orga/processed/sessions/*",
        "arn:aws:s3:::csc3104-cowrie-orgb/orgb/processed/sessions/*",
        "arn:aws:s3:::csc3104-cowrie-orgc/orgc/processed/sessions/*"
      ]
    }
  ]
}
